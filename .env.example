# Placeholders only. Set private values explicitly; application does not auto-migrate.
DATABASE_URL=postgresql+psycopg2://<app_role>:<url_encoded_password>@localhost:5432/<local_identity_database>
AUTH_ALLOWED_ORIGINS=http://localhost:5173
# False ONLY for loopback HTTP development. True for HTTPS deployment.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
# Supply bootstrap credentials privately and temporarily; do not save them here.
# BOOTSTRAP_ADMIN_USERNAME=<institutional_admin_email>
# BOOTSTRAP_ADMIN_PASSWORD=<unique_private_password_at_least_12_characters>
